     return os.environ.get("APPLYR_STAGE0_SUBSCRIPTION_ADAPTER", "").strip() == "1"
 
 
+def _rewrite_queue_hm_prose_files(folder: str) -> None:
+    """Correct mechanical hiring-manager holds before Stage 1 is sealed.
+
+    The queue already records the hiring-manager read when it is the only
+    open warning. A cliche opener or an ownership verb on a contributed
+    claim used to leave that read unwritten and pause the job. This rewrites
+    those two shapes in place so the next validate hashes the corrected
+    text. Other warnings stay. Implements FR-265.
+    """
+    if not _queue_hm_settle_enabled():
+        return
+    resume_path = os.path.join(folder, "Resume.md")
+    letter_path = os.path.join(folder, "CoverLetter.md")
+    if not os.path.isfile(resume_path) or not os.path.isfile(letter_path):
+        return
+    from submission_linter import rewrite_queue_hm_prose
+
+    resume = Path(resume_path).read_text(encoding="utf-8")
+    letter = Path(letter_path).read_text(encoding="utf-8")
+    new_resume, new_letter = rewrite_queue_hm_prose(resume, letter)
+    if new_resume == resume and new_letter == letter:
+        return
+    if not _retarget_provenance_units(folder, resume, new_resume, letter, new_letter):
+        return
+    if new_resume != resume:
+        Path(resume_path).write_text(new_resume, encoding="utf-8")
+    if new_letter != letter:
+        Path(letter_path).write_text(new_letter, encoding="utf-8")
+
+
+def _needs_stage1_recheck(folder: str, state: dict[str, Any]) -> bool:
+    """True when a sealed Stage 1 receipt missed a hard block.
+
+    The hiring-manager pass used to be the first place that block appeared.
+    A fresh hash then skipped verify, the queue paused, and nothing retried.
+    Implements FR-384.
+    """
+    if state.get("status") != "NEEDS_DISPOSITION":
+        return False
+    from submission_linter import lint_folder
+
+    for row in lint_folder(folder):
+        result = row.get("result") if isinstance(row, dict) else None
+        if getattr(result, "blocks", None):
+            return True
+    return False
+
+
+def _retarget_provenance_units(
+    folder: str,
+    old_resume: str,
+    new_resume: str,
+    old_letter: str,
+    new_letter: str,
+) -> bool:
+    """Point stored cites at the rewritten bullet or sentence.
+
+    Sentence provenance matches the exact unit. A verb or opener change
+    with the old cite text left in place fails Stage 1. Returns False when
+    the unit lists no longer line up, and then the draft is left unchanged.
+    Implements FR-265.
+    """
+    path = Path(folder) / "claim_provenance.json"
+    if not path.is_file():
+        return True
+    try:
+        payload = json.loads(path.read_text(encoding="utf-8"))
+    except (OSError, json.JSONDecodeError):
+        return False
+    if not isinstance(payload, dict):
+        return False
+    from author_from_packet import (
+        _cover_factual_sentences,
+        _normalize_provenance_unit,
+        _professional_experience_bullets,
+    )
+
+    pairs = (
+        ("resume_claims", "bullet", old_resume, new_resume, _professional_experience_bullets),
+        ("cover_letter_claims", "sentence", old_letter, new_letter, _cover_factual_sentences),
+    )
+    dirty = False
+    for section, field, old_text, new_text, splitter in pairs:
+        old_units = splitter(old_text)
+        new_units = splitter(new_text)
+        if len(old_units) != len(new_units):
+            return False
+        mapping = {
+            _normalize_provenance_unit(old): new
+            for old, new in zip(old_units, new_units)
+            if old != new
+        }
+        if not mapping:
+            continue
+        rows = payload.get(section)
+        if not isinstance(rows, list):
+            return False
+        found: set[str] = set()
+        pending: list[tuple[dict[str, Any], str, str]] = []
+        for row in rows:
+            if not isinstance(row, dict):
+                continue
+            value = row.get(field)
+            if not isinstance(value, str):
